# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (publishable) key — safe to expose to the browser.
# Row-Level Security is what protects the data, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by the scheduled scorer/eviction job to write final results & eliminations.
SUPABASE_SERVICE_ROLE_KEY=

# ─── NFL data provider ───────────────────────────────────────────────────────
# Which provider the abstraction layer uses. "espn" (default, free/unofficial)
# is the only implementation wired in v1; "mock" serves bundled fixture data.
NFL_PROVIDER=espn

# ─── Scheduled job auth ──────────────────────────────────────────────────────
# Shared secret the Netlify scheduled function presents to the poll endpoint.
CRON_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used to build invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
