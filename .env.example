# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (publishable) key — safe to expose to the browser.
# Row-Level Security is what protects the data, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by the scheduled scorer/eviction job to write final results & eliminations,
# and by load-schedule to bulk-load the season. `games` has a SELECT policy and no
# INSERT policy, so this key is the ONLY thing that can write the schedule.
# Without it in the Netlify environment, nothing automated runs at all.
SUPABASE_SERVICE_ROLE_KEY=

# ─── NFL data provider ───────────────────────────────────────────────────────
# Which provider the abstraction layer uses. "espn" (default, free/unofficial)
# is the only implementation wired in v1; "mock" serves bundled fixture data.
NFL_PROVIDER=espn

# Season to poll and load. Defaults to the current UTC year, so normally unset.
# NFL_SEASON=2026
#
# (There is no NFL_WEEK. poll-scores derives the live week from the schedule in
# Postgres; pinning it to an env var is what kept it re-polling Week 1 forever.)

# ─── Scheduled job auth ──────────────────────────────────────────────────────
# Shared secret for the on-demand schedule loader. Presented as an `x-cron-secret`
# header or a `?key=` query parameter:
#
#   /.netlify/functions/load-schedule?key=<CRON_SECRET>
#
# load-schedule fails CLOSED: unset this and the endpoint returns 503 rather than
# running unauthenticated. poll-scores is deliberately NOT gated — Netlify's cron
# cannot send a custom header, and it is idempotent (derived from ESPN, recomputed
# from real results), so an unwanted trigger costs function minutes and nothing more.
CRON_SECRET=

# ─── Email (reminders) ───────────────────────────────────────────────────────
# Resend API key for the admin drawer's Emails tab (missing-pick and unpaid
# buy-in reminders). Server only — never prefix with NEXT_PUBLIC_.
#
# THIS IS NOT THE KEY THAT SENDS MAGIC LINKS. That one lives in Supabase's own
# Auth → Emails → SMTP Settings, which no code in this repo can read; keeping
# them separate means rotating one cannot break sign-in, and Resend → Logs tells
# them apart (SMTP v1.0.0 requests versus API requests).
#
# A Resend key is scoped to ONE domain. A key issued for another project answers
# "API key not authorized for this domain" — which is exactly how the sign-in
# domain cutover broke once already — so issue this one with sending access for
# sheepwithglasses.com. Unset, the Emails tab says so and sends nothing.
RESEND_API_KEY=

# Optional. Defaults to "Sheep with Glasses <noreply@sheepwithglasses.com>".
# Must be on a domain verified with Resend.
# REMINDER_FROM=

# Set to 1 to render and log reminders without sending any. Writes nothing to
# reminder_sends either, so a dry run cannot burn the idempotence keys and
# suppress the real send afterwards. See docs/dry-run.md.
# REMINDER_DRY_RUN=1

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used to build invite links AND the links inside reminder
# emails. In Netlify this is scoped per deploy context: production holds the
# custom domain and every other context is deliberately BLANK.
#
# That blank is what makes reminders a production-only action. sendReminders
# refuses rather than guessing an origin, so you cannot mail the league from a
# deploy preview — a wrong link in a redirect is recoverable, the same link in
# twelve inboxes is not.
NEXT_PUBLIC_APP_URL=http://localhost:3000
